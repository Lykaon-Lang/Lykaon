{
  "name": "lykaon",
  "displayName": "Lykaon",
  "description": "Lykaon language support: syntax highlighting, LSP diagnostics, completion, formatting, run and test.",
  "icon": "icons/lykaon.png",
  "version": "0.2.0",
  "publisher": "Lykaon-Lang",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lykaon-Lang/Lykaon.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:lykaon",
    "onDebugResolve:lykaon"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "lykaon",
        "aliases": [
          "Lykaon",
          "lykaon"
        ],
        "extensions": [
          ".lykaon"
        ],
        "configuration": "./language-configuration.json",
        "icon": "./icons/lykaon.svg"
      }
    ],
    "grammars": [
      {
        "language": "lykaon",
        "scopeName": "source.lykaon",
        "path": "./syntaxes/lykaon.tmLanguage.json"
      }
    ],
    "debuggers": [
      {
        "type": "lykaon",
        "label": "Lykaon",
        "languages": [
          "lykaon"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Path to the .lykaon file to debug.",
                "default": "${file}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop at the first statement.",
                "default": false
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "lykaon",
            "request": "launch",
            "name": "Debug Lykaon file",
            "program": "${file}"
          }
        ]
      }
    ],
    "breakpoints": [
      {
        "language": "lykaon"
      }
    ],
    "commands": [
      {
        "command": "lykaon.run",
        "title": "Run File",
        "category": "Lykaon"
      },
      {
        "command": "lykaon.test",
        "title": "Test File",
        "category": "Lykaon"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "editorLangId == lykaon",
          "command": "lykaon.run",
          "group": "navigation@1"
        },
        {
          "when": "editorLangId == lykaon",
          "command": "lykaon.test",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "when": "editorLangId == lykaon",
          "command": "lykaon.run",
          "group": "z_commands@1"
        },
        {
          "when": "editorLangId == lykaon",
          "command": "lykaon.test",
          "group": "z_commands@2"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "Lykaon",
      "properties": {
        "lykaon.serverPath": {
          "type": "string",
          "default": "lykaonc-cli",
          "description": "Path to the Lykaon language server. Leave the default to find it automatically (installed copy, then the open file's folder, then PATH)."
        },
        "lykaon.interpreterPath": {
          "type": "string",
          "default": "lykaon-cli",
          "description": "Path to the Lykaon interpreter (Run). Leave the default to find it automatically."
        },
        "lykaon.compilerPath": {
          "type": "string",
          "default": "lykaonc-cli",
          "description": "Path to the Lykaon compiler (run/test/debug). Leave the default to find it automatically."
        },
        "lykaon.formatOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Format Lykaon files on save."
        }
      }
    },
    "snippets": [
      {
        "language": "lykaon",
        "path": "./snippets/lykaon.json"
      }
    ],
    "keybindings": [
      {
        "command": "lykaon.run",
        "key": "ctrl+f5",
        "when": "editorLangId == lykaon"
      },
      {
        "command": "lykaon.test",
        "key": "ctrl+shift+f5",
        "when": "editorLangId == lykaon"
      }
    ],
    "iconThemes": [
      {
        "id": "lykaon-file-icons",
        "label": "Lykaon",
        "path": "./icon-theme.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "echo \"no build step\""
  },
  "iconThemes": [
    {
      "id": "lykaon",
      "label": "Lykaon",
      "path": "./icon-theme.json"
    }
  ]
}
